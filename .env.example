# ============================================================
# ODS2 - CONFIGURACION LOCAL
# ============================================================

AIRFLOW_UID=cambiar_este_valor

# PostgreSQL de negocio
POSTGRES_DB=ods2_dw
POSTGRES_USER=ods2_admin
POSTGRES_DB_PASSWORD=cambiar_este_valor

POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# PostgreSQL exclusivo para metadatos de Airflow
AIRFLOW_DB=cambiar_este_valor
AIRFLOW_DB_USER=cambiar_este_valor
AIRFLOW_DB_PASSWORD=cambiar_este_valor

# Usuario administrador de la interfaz Airflow
AIRFLOW_ADMIN_USERNAME=cambiar_este_valor
AIRFLOW_ADMIN_FIRSTNAME=cambiar_este_valor
AIRFLOW_ADMIN_LASTNAME=cambiar_este_valor
AIRFLOW_ADMIN_EMAIL=cambiar_este_valor
AIRFLOW_ADMIN_PASSWORD=cambiar_este_valor

# Airflow: cifrado de credenciales y tokens de autenticacion
AIRFLOW_FERNET_KEY=cambiar_este_valor
AIRFLOW__API_AUTH__JWT_SECRET=cambiar_este_valor

# Imagen de Airflow
AIRFLOW_IMAGE_NAME=cambiar_este_valor
AIRFLOW_VERSION=cambiar_este_valor

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ods2.weather.daily

